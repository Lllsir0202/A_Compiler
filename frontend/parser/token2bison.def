// Some tokens without values
// KeyWords
NOVAL(IF, IF)
NOVAL(ELSE, ELSE)
NOVAL(WHILE, WHILE)
NOVAL(BREAK, BREAK)
NOVAL(CONTINUE, CONTINUE)
NOVAL(RETURN, RETURN)
NOVAL(INTEGER, INT)
NOVAL(FLOAT, FLOAT)
NOVAL(VOID, VOID)
NOVAL(CONST, CONST)
// Representing the end of file
NOVAL(END, END)

// Algorithm Operators
NOVAL(PLUS, ADD)
NOVAL(MINUS, SUB)
NOVAL(STAR, MUL)
NOVAL(DIV, DIV)
NOVAL(MOD, MOD)
NOVAL(ASSIGN, ASSIGN)

// Relational Operators
NOVAL(LESS, LT)
NOVAL(GREATER, GT)
NOVAL(LEQUAL, LE)
NOVAL(GEQUAL, GE)
NOVAL(EQUAL, EQ)
NOVAL(NEQUAL, NEQ)

// Logical Operators
NOVAL(AND, AND)
NOVAL(OR, OR)
NOVAL(NOT, NOT)

// Some punctuation
NOVAL(LCBRACE, LCBRACE)
NOVAL(RCBRACE, RCBRACE)
NOVAL(LSBRACE, LSBRACE)
NOVAL(RSBRACE, RSBRACE)
NOVAL(LPAREN, LPAREN)
NOVAL(RPAREN, RPAREN)
NOVAL(SEMICOLON, SEMICOLON)
NOVAL(COMMA, COMMA)