// Correctness boundary (C7): with a COMPILE-TIME constant boundMain that wraps,
// CanPartialUnroll rejects the loop statically and it stays un-optimised. The
// output must match the reference (5 iterations of i -= 8 from INT_MAX-37).
int main() {
    int i = 2147483637;
    int b = 2147483597;
    int s = 0;
    while (i > b) {
        s = s + 1;
        i = i - 8;
    }
    putint(s);
    return 0;
}
