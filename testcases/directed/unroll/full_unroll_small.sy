// A constant-trip-count loop (10 <= 64) is fully unrolled: no header, body, or
// latch survives.  The exit block may retain its source-derived debug name.
//! CHECK-NOT: main_while_(header|body|latch)
int main() {
    int i = 0;
    int s = 0;
    int x = getint();
    while (i < 10) {
        s = s + x;
        i = i + 1;
    }
    putint(s);
    return 0;
}
