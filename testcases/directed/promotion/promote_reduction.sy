// Scalar promotion: the g[2] read-modify-write becomes a loop-carried
// register; the body keeps no memory access, each loop exit gets one store.
//! CHECK-BLOCK-NOT: main_while_body :: var\.set
//! CHECK-BLOCK-NOT: main_while_body :: var\.getval
//! CHECK-BLOCK: main_while_exit :: var\.set
int g[10];
int main() {
    int n = getint();
    int i = 0;
    while (i < n) {
        g[2] = g[2] + i;
        i = i + 1;
    }
    putint(g[2]);
    return 0;
}
