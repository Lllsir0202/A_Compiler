int wide_cycle(int rounds) {
  int v0 = 0;
  int v1 = 1;
  int v2 = 2;
  int v3 = 3;
  int v4 = 4;
  int v5 = 5;
  int v6 = 6;
  int v7 = 7;
  int v8 = 8;
  int v9 = 9;
  int v10 = 10;
  int v11 = 11;
  int v12 = 12;
  int v13 = 13;
  int v14 = 14;
  int v15 = 15;
  int v16 = 16;
  int v17 = 17;
  int v18 = 18;
  int v19 = 19;
  int v20 = 20;
  int v21 = 21;
  int v22 = 22;
  int v23 = 23;
  int v24 = 24;
  int v25 = 25;
  int v26 = 26;
  int v27 = 27;
  int i = 0;
  while (i < rounds) {
    int old = v0;
    v0 = v1;
    v1 = v2;
    v2 = v3;
    v3 = v4;
    v4 = v5;
    v5 = v6;
    v6 = v7;
    v7 = v8;
    v8 = v9;
    v9 = v10;
    v10 = v11;
    v11 = v12;
    v12 = v13;
    v13 = v14;
    v14 = v15;
    v15 = v16;
    v16 = v17;
    v17 = v18;
    v18 = v19;
    v19 = v20;
    v20 = v21;
    v21 = v22;
    v22 = v23;
    v23 = v24;
    v24 = v25;
    v25 = v26;
    v26 = v27;
    v27 = old;
    i = i + 1;
  }
  return v0 + v1 * 2 + v2 * 3 + v3 * 4 + v4 * 5 + v5 * 6 + v6 * 7 + v7 * 8 + v8 * 9 +
         v9 * 10 + v10 * 11 + v11 * 12 + v12 * 13 + v13 * 14 + v14 * 15 + v15 * 16 + v16 * 17 +
         v17 * 18 + v18 * 19 + v19 * 20 + v20 * 21 + v21 * 22 + v22 * 23 + v23 * 24 + v24 * 25 +
         v25 * 26 + v26 * 27 + v27 * 28;
}

int main() {
  int a = 1;
  int b = 2;
  int c = 3;
  int sum = 0;
  float x = 1.25;
  float y = 2.5;
  int i = 0;
  while (i < 40) {
    if (i / 2 * 2 == i) {
      int old_a = a;
      a = b;
      b = c;
      c = old_a;
      float old_x = x;
      x = y;
      y = old_x;
    } else {
      int old_c = c;
      c = b;
      b = a;
      a = old_c;
    }
    sum = sum + a * 7 + b * 5 + c * 3 + i;
    i = i + 1;
  }
  putint(sum);
  putch(10);
  putfloat(x + y);
  putch(10);
  putint(wide_cycle(getint()));
  putch(10);
  return 0;
}
