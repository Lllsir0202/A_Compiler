// A recursive scalar-only function is referentially transparent. Repeating
// the call with identical SSA arguments is redundant even though the callee
// is recursive.
//! CHECK-COUNT: 2 :: base.call@pure
int pure(int x) {
    if (x <= 1) {
        return x;
    }
    return pure(x / 2) + 3;
}

int main() {
    int x = getint();
    int a = pure(x);
    int b = pure(x);
    putint(a + b);
    return 0;
}
