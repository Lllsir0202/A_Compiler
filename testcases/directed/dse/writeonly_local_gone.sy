// DSE: the local array is written in the loop but never read and never
// escapes -- every store to it is dead, so no store survives anywhere.
//! CHECK-NOT: var\.set
int main() {
    int a[10];
    int n = getint();
    int i = 0;
    while (i < n) {
        a[3] = i;
        i = i + 1;
    }
    putint(n);
    return 0;
}
