int calculate(int value) {
  int index = 0;
  int result = value;
  while (index < 3) {
    result = result * 3 + index;
    index = index + 1;
  }
  return result;
}

int first[32];
int second[32];

int main() {
  int count = getint();
  int i = 0;
  int j = 0;
  while (i < count) {
    first[i] = calculate(i);
    i = i + 1;
  }
  while (j < count) {
    second[j] = calculate(j + 1);
    j = j + 1;
  }
  putint(first[count - 1] + second[count - 1]);
  putch(10);
  return 0;
}
