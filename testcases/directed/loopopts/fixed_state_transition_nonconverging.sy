//! CHECK-STATS: FixedStateTransition: loops=1 candidates=1 transformed=1

int state;
int output;

int transition(int recurse) {
  state = 1 - state;
  output = state + 7;
  if (recurse > 0) {
    return transition(recurse - 1);
  }
  return output;
}

int main() {
  int remaining = 5;
  int last = 0;
  while (remaining > 0) {
    last = transition(0);
    remaining = remaining - 1;
  }
  putint(state);
  putch(32);
  putint(last);
  putch(32);
  putint(output);
  putch(10);
  return 0;
}
