int values[16];

int update(int lhs[], int rhs[], int count) {
  int i = 0;
  int j = 0;
  int sum = 0;
  while (i < count) {
    lhs[i] = i + 10;
    i = i + 1;
  }
  while (j < count) {
    sum = sum + rhs[j + 1];
    j = j + 1;
  }
  return sum;
}

int main() {
  int count = getint();
  putint(update(values, values, count));
  putch(10);
  return 0;
}
