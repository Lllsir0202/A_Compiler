//! CHECK-STATS: LoopUnswitch: candidates=1 unswitched=1

int main() {
  int flag = getint();
  int count = getint();
  int i = 0;
  int sum = 0;
  while (i < count) {
    if (flag != 0) {
      if (i == 3) {
        break;
      }
    }
    sum = sum + i;
    i = i + 1;
  }
  putint(sum);
  putch(10);
  return 0;
}
