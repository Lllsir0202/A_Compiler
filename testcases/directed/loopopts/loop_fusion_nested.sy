int first[128];
int second[128];

int main() {
  int count = getint();
  int i = 0;
  int j = 0;
  while (i < count) {
    int k = 0;
    while (k < 4) {
      first[i * 4 + k] = i + k;
      k = k + 1;
    }
    i = i + 1;
  }
  while (j < count) {
    int k = 0;
    while (k < 4) {
      second[j * 4 + k] = j - k;
      k = k + 1;
    }
    j = j + 1;
  }
  putint(first[(count - 1) * 4 + 3] + second[(count - 1) * 4 + 3]);
  putch(10);
  return 0;
}
