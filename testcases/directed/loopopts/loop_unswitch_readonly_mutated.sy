//! CHECK-STATS: LoopUnswitch: candidates=0 unswitched=0

int flag;

int main() {
  int count = getint();
  flag = getint();
  int i = 0;
  int sum = 0;
  while (i < count) {
    if (flag != 0) {
      sum = sum + i;
    } else {
      sum = sum - i;
    }
    flag = i - count / 2;
    i = i + 1;
  }
  putint(sum);
  putch(10);
  return 0;
}
