int a[9][8];

int main() {
  int col = 0;
  int row = 0;
  int col2 = 0;
  int sum = 0;
  while (col < 8) {
    row = 0;
    while (row < 9) {
      a[row][col] = row * 8 + col + 3;
      row = row + 1;
    }
    col = col + 1;
  }

  row = 0;
  while (row < 9) {
    col2 = 0;
    while (col2 < 8) {
      sum = sum + a[row][col2];
      col2 = col2 + 1;
    }
    row = row + 1;
  }
  putint(sum);
  return 0;
}
