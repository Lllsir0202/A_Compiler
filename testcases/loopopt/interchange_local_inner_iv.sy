int data[8][6];

int main() {
  int row = 0;
  while (row < 8) {
    int col = 0;
    while (col < 6) {
      data[row][col] = row * 6 + col + 1;
      col = col + 1;
    }
    row = row + 1;
  }

  int col = 0;
  int sum = 0;
  while (col < 6) {
    int scan_row = 0;
    while (scan_row < 8) {
      sum = sum + data[scan_row][col] * (scan_row + col + 1);
      scan_row = scan_row + 1;
    }
    col = col + 1;
  }
  putint(sum);
  return 0;
}
