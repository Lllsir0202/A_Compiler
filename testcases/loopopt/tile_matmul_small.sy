int a[64][64], b[64][64], c[64][64];
int main() {
  int i = 0, j = 0, k = 0;
  while (i < 64) { j = 0; while (j < 64) { a[i][j] = i + j; b[i][j] = i * j; c[i][j] = 0; j = j + 1; } i = i + 1; }
  k = 0;
  while (k < 64) { i = 0; while (i < 64) { j = 0; while (j < 64) { c[i][j] = c[i][j] + a[i][k] * b[k][j]; j = j + 1; } i = i + 1; } k = k + 1; }
  putint(c[3][7]); putint(c[63][63]);
  return 0;
}
