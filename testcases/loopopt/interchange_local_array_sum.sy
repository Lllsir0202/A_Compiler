int main() {
  int a[10][7];
  int row = 0;
  while (row < 10) {
    int col = 0;
    while (col < 7) {
      a[row][col] = row * 7 + col + 1;
      col = col + 1;
    }
    row = row + 1;
  }

  int col = 0;
  int sum = 0;
  while (col < 7) {
    int scan = 0;
    while (scan < 10) {
      sum = sum + a[scan][col] * (col + 1);
      scan = scan + 1;
    }
    col = col + 1;
  }
  putint(sum);
  return 0;
}
