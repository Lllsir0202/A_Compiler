int matrix[64][64];

int main() {
  int row = 0, col = 0, sum = 0;
  while (row < 64) {
    col = 0;
    while (col < 64) {
      matrix[row][col] = row * 64 + col + 1;
      col = col + 1;
    }
    row = row + 1;
  }
  col = 0;
  while (col < 64) {
    row = 0;
    while (row < 64) {
      sum = sum + matrix[row][col];
      row = row + 1;
    }
    col = col + 1;
  }
  putint(sum);
  return 0;
}
