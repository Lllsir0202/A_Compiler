int a[4][8][6];

int main() {
  int x = 0;
  int row = 0;
  int col = 0;
  int sum = 0;
  while (x < 4) {
    row = 0;
    while (row < 8) {
      col = 0;
      while (col < 6) {
        a[x][row][col] = x * 100 + row * 6 + col + 1;
        col = col + 1;
      }
      row = row + 1;
    }
    x = x + 1;
  }

  col = 0;
  while (col < 6) {
    row = 0;
    while (row < 8) {
      sum = sum + a[2][row][col];
      row = row + 1;
    }
    col = col + 1;
  }
  putint(sum);
  return 0;
}
