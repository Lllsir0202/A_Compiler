int A[8][8];
int C[8][8];

int main() {
  int n = getint();
  // The competition runtime and the local Spike runtime use different stdin wrappers.  Keeping the
  // bound dynamic still exercises runtime unroll-and-jam, while this clamp makes both deterministic.
  if (n < 1) {
    n = 5;
  }
  if (n > 8) {
    n = 5;
  }
  int i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      A[i][j] = i * 7 + j + 1;
      C[i][j] = (i + 1) * 3 - j;
      j = j + 1;
    }
    i = i + 1;
  }

  i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      int k = 0;
      int sum = 0;
      while (k < n) {
        sum = sum + C[i][k] * A[k][j];
        k = k + 1;
      }
      A[i][j] = sum;
      j = j + 1;
    }
    i = i + 1;
  }

  int checksum = 0;
  i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      checksum = checksum + A[i][j] * (i + j + 1);
      j = j + 1;
    }
    i = i + 1;
  }
  putint(checksum);
  putch(10);
  return 0;
}
