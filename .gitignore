!.gitkeep
bin/
compile_commands.json
.cache/
build/
objs/
# Ignore generated lexer and parser files
frontend/lexer/*.h
!frontend/lexer/lexer.h
!frontend/lexer/*_impl.h
!frontend/lexer/FlexLexer.h
frontend/parser/*.h
!frontend/parser/parser.h
!frontend/parser/parser_utils.h
!frontend/parser/*_impl.h
frontend/lexer/*.cpp
!frontend/lexer/lexer.cpp
!frontend/lexer/*_impl.cpp
frontend/parser/*.cpp
!frontend/parser/parser.cpp
!frontend/parser/*_impl.cpp
# Ignore all test files
test*.*
test
*.output
testcases/
testoutputs/

# Ignore Config files
.vscode/

# Since the archicture is different
# We ignore the librarys
libs/*.a

# Ignore the normalized initializer output file
normalized_initializer.txt

# Ignore the generated llvm ir file
tmp.*
a.out
cfgs/

# Ignore python cache files
__pycache__/
*.pyc

# Ignore valgrind output files
valgrind_output.*
/bench/
.claude/
