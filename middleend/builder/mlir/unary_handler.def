/**
 * @brief the macro definition for handling unary operators in MLIR visitor
 */
#define UNARY_OPERATOR_HANDLER(op_code, op_name)                                                                      \
  case frontend::ast::OpCode::op_code: {                                                                              \
    auto op = GET_MLIR_CONTEXT()->CreateOperation<middleend::mlir::arithm::op_name##Op>(GET_MLIR_CONTEXT(), operand); \
    GET_MLIR_CONTEXT()->GetInsertPoint()->AddOperation(op);                                                           \
    GET_MLIR_CONTEXT()->GetResourceContext()->MapExprToValue(unary_expr, op->GetRes());                               \
    result = op->GetRes();                                                                                            \
    /* Set the operation of the result value*/                                                                        \
    result->op_ = op;                                                                                                 \
    operand->AddUse(op, 0);                                                                                           \
  } break;
