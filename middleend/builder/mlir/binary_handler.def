/**
 * @brief the macro definition for handling binary operators in MLIR visitor
 */
#define BINARY_OPERATOR_HANDLER(op_code, op_name)                                                                      \
  case frontend::ast::OpCode::op_code: {                                                                               \
    auto op = GET_MLIR_CONTEXT()->CreateOperation<middleend::mlir::arithm::op_name##Op>(GET_MLIR_CONTEXT(), lhs, rhs); \
    GET_MLIR_CONTEXT()->GetInsertPoint()->AddOperation(op);                                                            \
    GET_MLIR_CONTEXT()->GetResourceContext()->MapExprToValue(binary_expr, op->GetRes());                               \
    result = op->GetRes();                                                                                             \
  } break;
