/**
 * @brief Since most of the binary operations have the same structure,
 * we can use a macro to define these binary operations
 */
#define DEFINE_BINARY_OP(NAME)                                                                   \
  class NAME##Op : public ArithmOps {                                                            \
   public:                                                                                       \
    static auto Create(MLIRBuilder *builder, mlir::Value *lhs, mlir::Value *rhs) -> NAME##Op * { \
      auto op = new NAME##Op();                                                                  \
      op->SetUp(builder, lhs, rhs);                                                              \
      return op;                                                                                 \
    }                                                                                            \
    auto GetLHS() -> mlir::Value * { return lhs_; }                                              \
    auto GetRHS() -> mlir::Value * { return rhs_; }                                              \
    auto GetRes() -> mlir::Value * { return res_; }                                              \
    auto Emit(std::ofstream *out) const -> void override {                                       \
      /* Implementation for emitting the operation */                                            \
      res_->Emit(out);                                                                           \
      *out << " = " << Name() << " ";                                                            \
      lhs_->Emit(out);                                                                           \
      *out << " , ";                                                                             \
      rhs_->Emit(out);                                                                           \
      *out << "\n";                                                                              \
    }                                                                                            \
                                                                                                 \
   private:                                                                                      \
    NAME##Op() : ArithmOps(#NAME) {}                                                             \
    auto SetUp(MLIRBuilder *builder, mlir::Value *lhs, mlir::Value *rhs) -> void {               \
      /* NAME##Op has two operands and one result */                                             \
      operands_.reserve(2);                                                                      \
      results_.reserve(1);                                                                       \
      operands_.emplace_back(lhs);                                                               \
      operands_.emplace_back(rhs);                                                               \
      lhs_ = lhs;                                                                                \
      rhs_ = rhs;                                                                                \
      auto res = builder->GetMLIRContext()->CreateValue();                                       \
      results_.emplace_back(res);                                                                \
      res_ = res;                                                                                \
    }                                                                                            \
    mlir::Value *lhs_;                                                                           \
    mlir::Value *rhs_;                                                                           \
    mlir::Value *res_;                                                                           \
  };